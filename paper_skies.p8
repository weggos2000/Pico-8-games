pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--random shizzle
function _init()
 cls(0)
 mode="start"
end
function _update()
	if mode=="game" then
		update_game()
	elseif mode=="start" then
		update_start()
	elseif mode=="gameover" then
	 update_gameover()
	end
end

function _draw()
	if mode=="game" then
		draw_game()
	elseif mode=="start" then
	 draw_start()
	elseif mode=="gameover" then
	 draw_gameover()
	end
end

function startgame()
	mode="game"
--player variables
	ship={}
	ship.x = 60
	ship.y = 100
	ship.spd = 2
	ship.spr = 2
	muzzle = 0
	score = "unknown"
	lives = 3
	bombs = 3
--player bullet 
	buls={}
--enemies
 enemies={}
 
 local myen={}
 myen.x=60
 myen.y=5
 myen.spr=16
 add(enemies,myen)
--map table
	starx={}
	stary={}
	starspd={}
	for i=1,100 do
		add(starx,rnd(128))
		add(stary,rnd(128))
		add(starspd,rnd(1.5)+0.5)	
	end
	stars={}
	for i=1,100 do
	 local newstar={}
	 newstar.x=flr(rnd(128))
	 newstar.y=flr(rnd(128))
	 newstar.spd=rnd(1.5)+0.5
	 add(stars,newstar)
	end
end
-->8
-- tools
function starfield()
 for i=1,#stars do
  local mystar=stars[i]
  local scol=6
  if mystar.spd<1 then
  	scol=1
  elseif mystar.spd<1.5 then
   scol=13
  end
  pset(mystar.x,mystar.y,scol)
 end
end
function animatestars()
 for i=1,#stars do
  local mystar=stars[i]
  mystar.y=mystar.y+mystar.spd
  if mystar.y>128 then
  	mystar.y=mystar.y-128
  end
 end
end
function drawspr(myspr)
 spr(myspr.spr,myspr.x,myspr.y)
end
-->8
--update stuff (hopefully)
function update_game()
--player block
ship.spr = 2
-- plane movement & anims
 if btn(➡️) then
 	ship.x+=ship.spd
 	ship.spr = 1
 elseif btn(⬅️) then
  ship.x-=ship.spd
  ship.spr = 3
 end
 if btn(⬆️) then
 	ship.y-=ship.spd
 elseif btn(⬇️) then
 	ship.y+=ship.spd
 end
--muzzle flash anim
if muzzle > 0 then
	muzzle-=1
end
--thou shall not leave (my gf wants it to be "thou shall not pass" but i dissagree with this vile comment)
 if ship.x>120 then
  ship.x=120
 elseif ship.x<0 then
  ship.x=0
 end

-- end movement block
-- shooting mechanics block

	if btnp(🅾️) then
	 local newbul={}
	 newbul.x = ship.x
	 newbul.y = ship.y
	 newbul.spr = 48
	 add (buls,newbul)
		sfx(0)
		muzzle=5
	end
	
	--move bullets
	for i=#buls,1,-1 do
		local mybul=buls[i]
		mybul.y = mybul.y-4
	 
	 if mybul.y<-8 then
	  deli(buls,i)
	 end
	end
	--move enemies
	for myen in all(enemies) do
		myen.y+=1
		myen.x+=rnd(2)-1
		myen.spr+=0.25
		if myen.spr>=18 then
			myen.spr=16
		end
		if myen.y>128 then
		 del(enemies.myen)
		end
	end

-- map stuff
	animatestars()
end

function update_start()
	if btnp(❎) or btnp(🅾️) then
	 startgame()
	end
end
function update_gameover()
 if btnp(❎) or btnp(🅾️) then
  mode="start"
 end
end
-->8
-- drawing stuff
function draw_game()
	cls()
	starfield()
	drawspr(ship)
	--draw bullets
	for mybul in all(buls) do
		drawspr(mybul)
	end
	--draw enemies
	for myenem in all(enemies) do
	 drawspr(myenem)
	end
	if muzzle>0 then
		circfill(ship.x+3,ship.y-1,muzzle,7)
	end
	
	print("score: "..score,40,1,12)
	
	for i=1,3 do
		if lives>=i then
			spr(14,i*8-8,1)
	 else
	 	spr(15,i*7-8,1)
	 end
	 if bombs>=i then
	  spr(13,128-i*6,1)
	 end
	end 
end

function draw_start()
	cls(1)
	print("paper skies", 40, 40, 12)
	print("press any key to start",20, 80, 7)
end

function draw_gameover()
	cls(4)
	print("game over =(", 40, 40, 12)
	print("press any key to continue",20, 80, 7)
end

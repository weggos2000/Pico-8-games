pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	playerx = 60
	playery = 100
	playerspeed = 2
	bulx=0
	buly=0
	bulspd=3
end

function _update()
-- movement block

-- plane movement
 if btn(➡️) then
 	playerx+=playerspeed
 elseif btn(⬅️) then
  playerx-=playerspeed
 end
 if btn(⬆️) then
 	playery-=playerspeed
 elseif btn(⬇️) then
 	playery+=playerspeed
 end
-- you shall not leave
 if playerx>120 then
  playerx=120
 elseif playerx<0 then
  playerx=0
 end

-- end movement block
-- shooting mechanics block

	if btnp(🅾️) then
		buly=playery
		bulx=playerx
		sfx(0)
	end
	
	buly=buly-bulspd
end

function _draw()
	cls()
	spr(1,playerx,playery)
	spr(3,bulx,buly)
end
